# Caddy in front of the app (SPEC2 5, 13): HTTPS with automatic certificates (for the site
# address `localhost`, Caddy's own local certificate), HSTS, request bodies of at most 27 MB.
# Caddy sets X-Forwarded-For itself, discarding any the client sent, and keeps no access log.
{
	admin off
	# The container's root is read-only; its own trust store is not used by anyone.
	skip_install_trust
	# A browser that asks by IP address names no site; it gets the site address's certificate.
	default_sni {$SITE_ADDRESS}
}

# The site address, and any other name or IP address the server is reached by (so that
# https://<the server's IP>:<port> works before a domain name is set up).
{$SITE_ADDRESS}, https:// {
	request_body {
		max_size 27MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	encode zstd gzip
	reverse_proxy app:3000
}
