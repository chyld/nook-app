{
  "name": "notes-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=26" },
  "workspaces": ["packages/contract", "packages/core", "packages/server", "packages/web", "e2e"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --workspace packages/web --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:css": "stylelint \"packages/web/src/**/*.{css,svelte}\" && node packages/web/scripts/raw-colours.ts",
    "test:core": "node --test --test-concurrency=4 \"packages/core/test/*.test.ts\"",
    "test:server": "node --test --test-concurrency=4 \"packages/server/test/*.test.ts\"",
    "test:web": "node --import ./packages/web/test/register.ts --test --test-concurrency=1 \"packages/web/test/*.test.ts\"",
    "test": "npm run test:core && npm run test:server && npm run test:web",
    "build": "vite build --config packages/web/vite.config.ts",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "start": "node packages/server/src/main.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "playwright": "^1.65.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
