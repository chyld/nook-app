# Optional. The app runs without this file, at https://localhost:9988.
# To change a setting, copy this file to .env and edit it. Never commit .env.

# The address people use. `localhost` gives Caddy's own local certificate, for trying the app
# on your machine. On a VPS: your domain name, e.g. notes.example.org (its DNS must point here).
SITE_ADDRESS=localhost

# Ports published on the host. On a VPS use 80 and 443.
HTTP_PORT=9987
HTTPS_PORT=9988

# Where container logs go: json-file anywhere; journald on a Linux host with systemd.
LOG_DRIVER=json-file

# The most memory the app may use; past it the app is restarted.
APP_MEMORY_LIMIT=768m

# Off-site backup with restic (section 13). The repository, e.g. s3:https://s3.example.com/bucket
# or sftp:user@host:/backups/notes, and its password (keep the password somewhere other than
# this VPS too). Add whatever credentials the repository needs.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
